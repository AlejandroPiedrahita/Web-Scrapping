# ==============================================================================
# AutoData ETL Pipeline - Variables de Entorno de Producción
# ==============================================================================

# Entorno de Ejecución (production, staging, development)
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Configuración del Servicio FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Base de Datos PostgreSQL / TimescaleDB
DB_HOST=postgres-primary
DB_PORT=5432
DB_USER=autodata_admin
DB_PASSWORD=SuperSecurePipelinePassword2025!
DB_NAME=autodata_db
DB_SSL_MODE=require
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Playwright & Stealth Scraper Cluster
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_WORKER_CONCURRENCY=32
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=30000
STEALTH_PROFILE_VERSION=v4.2

# Políticas de Evasión y Rotación de Proxies
PROXY_ROTATION_STRATEGY=residential_ipv6_auto
RESIDENTIAL_PROXY_GATEWAY=http://gate.brightdata.com:7000
PROXY_MAX_RETRIES=5
PROXY_BACKOFF_FACTOR=2.0
ADAPTIVE_JITTER_MIN_MS=300
ADAPTIVE_JITTER_MAX_MS=1250

# Reglas de Calidad y Cuarentena (SLA / Dead-Letter Queue)
MAX_NULL_FIELD_LIMIT=3
MIN_PRICE_USD=500.00
MAX_PRICE_USD=250000.00
DEAD_LETTER_QUEUE_ENABLED=true
